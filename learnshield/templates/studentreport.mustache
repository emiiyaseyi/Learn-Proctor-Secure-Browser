{{!
    @template quizaccess_learnshield/studentreport
    Per-student detail report with timeline and snapshots.
    @copyright 2025 Michael Adeniran
    @license   http://www.gnu.org/copyleft/gpl.html GNU GPL v3 or later
}}
<div class="learnshield-student-report">
    <div class="row mb-4">
        <div class="col-md-6">
            <table class="table table-sm table-bordered">
                <tr><th>Name</th><td>{{fullname}}</td></tr>
                <tr><th>Email</th><td>{{email}}</td></tr>
                <tr><th>Quiz</th><td>{{quizname}}</td></tr>
                <tr><th>Risk Score</th><td>
                    <span class="learnshield-risk-badge learnshield-risk-{{risk_level}}">
                        {{risk_score}} — {{risk_level_label}}
                    </span>
                </td></tr>
                <tr><th>Tab Switches</th><td>{{tab_switches}}</td></tr>
                <tr><th>Fullscreen Exits</th><td>{{fullscreen_exits}}</td></tr>
                <tr><th>Face Missing</th><td>{{face_missing_count}}</td></tr>
            </table>
        </div>
        <div class="col-md-6">
            <div class="learnshield-score-bar-wrap" style="height:16px;">
                <div class="learnshield-score-bar {{risk_level}}" style="width:{{risk_pct}}%;height:100%;"></div>
            </div>
        </div>
    </div>

    <h5>Snapshots</h5>
    <div class="learnshield-snapshot-grid mb-4">
        {{#snapshots}}
        <div class="learnshield-snapshot-item">
            <a href="{{webcampicture}}" class="ls-snapshot-thumb" data-lightbox="student-report">
                <img src="{{webcampicture}}" class="img-fluid" loading="lazy" alt="Snapshot"/>
            </a>
            <div class="learnshield-snapshot-caption">{{timemodified_formatted}}</div>
        </div>
        {{/snapshots}}
        {{^snapshots}}
        <p class="text-muted">No snapshots recorded.</p>
        {{/snapshots}}
    </div>
</div>
