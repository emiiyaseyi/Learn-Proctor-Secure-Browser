{{!
    @template quizaccess_learnshield/report
    Proctoring report row — one student's snapshots.
    @copyright 2025 Michael Adeniran
    @license   http://www.gnu.org/copyleft/gpl.html GNU GPL v3 or later
}}
<div class="card mb-4">
    <div class="card-header d-flex justify-content-between align-items-center flex-wrap">
        <div>
            <strong>{{fullname}}</strong>
            <span class="text-muted ml-2">&lt;{{email}}&gt;</span>
        </div>
        <div class="d-flex gap-2 align-items-center">
            <span class="learnshield-risk-badge learnshield-risk-{{risk_level}}">
                {{risk_level_label}}
            </span>
            <span class="badge badge-secondary">Score: {{risk_score}}</span>
        </div>
    </div>
    <div class="card-body">
        {{#has_snapshots}}
        <div class="learnshield-snapshot-grid">
            {{#snapshots}}
            <div class="learnshield-snapshot-item">
                <a href="{{webcampicture}}" class="ls-snapshot-thumb" data-lightbox="student-{{studentid}}">
                    <img src="{{webcampicture}}" class="img-fluid" alt="Snapshot" loading="lazy"/>
                </a>
                <div class="learnshield-snapshot-caption">{{timemodified_formatted}}</div>
            </div>
            {{/snapshots}}
        </div>
        {{/has_snapshots}}
        {{^has_snapshots}}
        <p class="text-muted">{{str_nodata}}</p>
        {{/has_snapshots}}
    </div>
</div>
