<?xml version="1.0" encoding="UTF-8" ?>
<XMLDB PATH="mod/learnguard/db" VERSION="2025051800"
       COMMENT="LearnGuard Assessment Module database schema"
       xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
       xsi:noNamespaceSchemaLocation="../../../../lib/xmldb/xmldb.xsd">
  <TABLES>

    <!-- Activity instances -->
    <TABLE NAME="learnguard" COMMENT="Each row is one LearnGuard activity instance">
      <FIELDS>
        <FIELD NAME="id"                 TYPE="int"  LENGTH="10" NOTNULL="true" SEQUENCE="true"/>
        <FIELD NAME="course"             TYPE="int"  LENGTH="10" NOTNULL="true"/>
        <FIELD NAME="name"               TYPE="char" LENGTH="255" NOTNULL="true"/>
        <FIELD NAME="intro"              TYPE="text" NOTNULL="false"/>
        <FIELD NAME="introformat"        TYPE="int"  LENGTH="4"  NOTNULL="true" DEFAULT="1"/>
        <FIELD NAME="timecreated"        TYPE="int"  LENGTH="10" NOTNULL="true" DEFAULT="0"/>
        <FIELD NAME="timemodified"       TYPE="int"  LENGTH="10" NOTNULL="true" DEFAULT="0"/>
        <!-- Timer -->
        <FIELD NAME="timelimit"          TYPE="int"  LENGTH="10" NOTNULL="true" DEFAULT="0" COMMENT="Seconds. 0 = no limit"/>
        <!-- Attempt controls -->
        <FIELD NAME="attempts"           TYPE="int"  LENGTH="6"  NOTNULL="true" DEFAULT="0" COMMENT="0 = unlimited"/>
        <FIELD NAME="questionsperpage"   TYPE="int"  LENGTH="10" NOTNULL="true" DEFAULT="1"/>
        <FIELD NAME="shufflequestions"   TYPE="int"  LENGTH="1"  NOTNULL="true" DEFAULT="0"/>
        <FIELD NAME="shuffleanswers"     TYPE="int"  LENGTH="1"  NOTNULL="true" DEFAULT="1"/>
        <!-- Grading -->
        <FIELD NAME="grade"              TYPE="int"  LENGTH="10" NOTNULL="true" DEFAULT="100"/>
        <FIELD NAME="grademethod"        TYPE="int"  LENGTH="4"  NOTNULL="true" DEFAULT="1" COMMENT="1=highest, 2=average, 3=first, 4=last"/>
        <FIELD NAME="decimalpoints"      TYPE="int"  LENGTH="4"  NOTNULL="true" DEFAULT="2"/>
        <!-- Review settings -->
        <FIELD NAME="reviewattempt"      TYPE="int"  LENGTH="10" NOTNULL="true" DEFAULT="0"/>
        <FIELD NAME="reviewcorrectness"  TYPE="int"  LENGTH="10" NOTNULL="true" DEFAULT="0"/>
        <FIELD NAME="reviewfeedback"     TYPE="int"  LENGTH="10" NOTNULL="true" DEFAULT="0"/>
        <FIELD NAME="reviewmaxmarks"     TYPE="int"  LENGTH="10" NOTNULL="true" DEFAULT="0"/>
        <!-- Proctoring settings -->
        <FIELD NAME="proctoring"         TYPE="int"  LENGTH="1"  NOTNULL="true" DEFAULT="1"/>
        <FIELD NAME="proctor_fullscreen" TYPE="int"  LENGTH="1"  NOTNULL="true" DEFAULT="1"/>
        <FIELD NAME="proctor_webcam"     TYPE="int"  LENGTH="1"  NOTNULL="true" DEFAULT="1"/>
        <FIELD NAME="proctor_audio"      TYPE="int"  LENGTH="1"  NOTNULL="true" DEFAULT="1"/>
        <FIELD NAME="proctor_tabdetect"  TYPE="int"  LENGTH="1"  NOTNULL="true" DEFAULT="1"/>
        <FIELD NAME="proctor_keyblock"   TYPE="int"  LENGTH="1"  NOTNULL="true" DEFAULT="1"/>
        <FIELD NAME="proctor_clipboard"  TYPE="int"  LENGTH="1"  NOTNULL="true" DEFAULT="1"/>
        <FIELD NAME="proctor_snapinterval" TYPE="int" LENGTH="10" NOTNULL="true" DEFAULT="30"/>
        <FIELD NAME="proctor_fcmethod"   TYPE="char" LENGTH="10" NOTNULL="true" DEFAULT="None"/>
        <FIELD NAME="proctor_env_record" TYPE="int"  LENGTH="1"  NOTNULL="true" DEFAULT="1" COMMENT="Require 360 environment recording"/>
        <FIELD NAME="block_mobile"       TYPE="int"  LENGTH="1"  NOTNULL="true" DEFAULT="1"/>
        <FIELD NAME="autosuspend_score"  TYPE="int"  LENGTH="10" NOTNULL="true" DEFAULT="80"/>
        <!-- Grading extras -->
        <FIELD NAME="gradepass"          TYPE="number" LENGTH="10" NOTNULL="true" DEFAULT="0" DECIMALS="5" COMMENT="Grade to pass"/>
        <!-- Availability window -->
        <FIELD NAME="timeopen"           TYPE="int"  LENGTH="10" NOTNULL="true" DEFAULT="0" COMMENT="Assessment opens (unix ts, 0=always open)"/>
        <FIELD NAME="timeclose"          TYPE="int"  LENGTH="10" NOTNULL="true" DEFAULT="0" COMMENT="Assessment closes (unix ts, 0=no close)"/>
        <!-- Result visibility -->
        <FIELD NAME="show_results"       TYPE="int"  LENGTH="1"  NOTNULL="true" DEFAULT="1" COMMENT="1=show immediately, 0=hold until teacher releases"/>
        <FIELD NAME="results_released"   TYPE="int"  LENGTH="10" NOTNULL="true" DEFAULT="0" COMMENT="Timestamp when results were released; 0=not yet released"/>
        <!-- Question randomization -->
        <FIELD NAME="randomize"          TYPE="int"  LENGTH="1"  NOTNULL="true" DEFAULT="0" COMMENT="1=give each student a random subset of questions"/>
        <FIELD NAME="num_questions"      TYPE="int"  LENGTH="10" NOTNULL="true" DEFAULT="0" COMMENT="How many random questions per student (0=all)"/>
        <!-- Exam content -->
        <FIELD NAME="instructions"       TYPE="text" NOTNULL="false"/>
        <FIELD NAME="instructionsformat" TYPE="int"  LENGTH="4"  NOTNULL="true" DEFAULT="1"/>
      </FIELDS>
      <KEYS>
        <KEY NAME="primary" TYPE="primary" FIELDS="id"/>
        <KEY NAME="course"  TYPE="foreign" FIELDS="course" REFTABLE="course" REFFIELDS="id"/>
      </KEYS>
    </TABLE>

    <!-- Student assessment attempts -->
    <TABLE NAME="learnguard_attempts" COMMENT="One record per student attempt">
      <FIELDS>
        <FIELD NAME="id"           TYPE="int"    LENGTH="10"  NOTNULL="true" SEQUENCE="true"/>
        <FIELD NAME="learnguard"   TYPE="int"    LENGTH="10"  NOTNULL="true" COMMENT="FK learnguard.id"/>
        <FIELD NAME="userid"       TYPE="int"    LENGTH="10"  NOTNULL="true"/>
        <FIELD NAME="attempt"      TYPE="int"    LENGTH="6"   NOTNULL="true" DEFAULT="1"/>
        <FIELD NAME="uniqueid"     TYPE="int"    LENGTH="10"  NOTNULL="true" COMMENT="question_usage id (quba)"/>
        <FIELD NAME="currentpage"  TYPE="int"    LENGTH="10"  NOTNULL="true" DEFAULT="0"/>
        <FIELD NAME="sumgrades"    TYPE="number" LENGTH="10"  NOTNULL="false" DECIMALS="5"/>
        <FIELD NAME="state"        TYPE="char"   LENGTH="16"  NOTNULL="true" DEFAULT="inprogress" COMMENT="inprogress|finished|abandoned"/>
        <FIELD NAME="timestart"    TYPE="int"    LENGTH="10"  NOTNULL="true" DEFAULT="0"/>
        <FIELD NAME="timefinish"   TYPE="int"    LENGTH="10"  NOTNULL="true" DEFAULT="0"/>
        <FIELD NAME="timemodified" TYPE="int"    LENGTH="10"  NOTNULL="true" DEFAULT="0"/>
        <!-- Proctoring -->
        <FIELD NAME="risk_score"   TYPE="int"    LENGTH="10"  NOTNULL="true" DEFAULT="0"/>
        <FIELD NAME="risk_level"   TYPE="char"   LENGTH="10"  NOTNULL="true" DEFAULT="low"/>
        <FIELD NAME="ip_address"   TYPE="char"   LENGTH="45"  NOTNULL="false"/>
        <FIELD NAME="browser_info" TYPE="text"   NOTNULL="false"/>
        <FIELD NAME="consent_given" TYPE="int"   LENGTH="1"   NOTNULL="true" DEFAULT="0"/>
        <FIELD NAME="is_flagged"   TYPE="int"    LENGTH="1"   NOTNULL="true" DEFAULT="0"/>
        <FIELD NAME="tab_switches" TYPE="int"    LENGTH="10"  NOTNULL="true" DEFAULT="0"/>
        <FIELD NAME="fs_exits"     TYPE="int"    LENGTH="10"  NOTNULL="true" DEFAULT="0"/>
        <FIELD NAME="face_missing" TYPE="int"    LENGTH="10"  NOTNULL="true" DEFAULT="0"/>
      </FIELDS>
      <KEYS>
        <KEY NAME="primary"    TYPE="primary" FIELDS="id"/>
        <KEY NAME="learnguard" TYPE="foreign" FIELDS="learnguard" REFTABLE="learnguard" REFFIELDS="id"/>
        <KEY NAME="uniqueid"   TYPE="foreign" FIELDS="uniqueid" REFTABLE="question_usages" REFFIELDS="id"/>
      </KEYS>
      <INDEXES>
        <INDEX NAME="userid"              UNIQUE="false" FIELDS="userid"/>
        <INDEX NAME="learnguard_userid"   UNIQUE="false" FIELDS="learnguard, userid"/>
        <INDEX NAME="learnguard_state"    UNIQUE="false" FIELDS="learnguard, state"/>
        <INDEX NAME="learnguard_timemod"  UNIQUE="false" FIELDS="learnguard, timemodified"/>
      </INDEXES>
    </TABLE>

    <!-- Webcam snapshots during attempt -->
    <TABLE NAME="learnguard_snapshots" COMMENT="Webcam snapshots taken during attempts">
      <FIELDS>
        <FIELD NAME="id"           TYPE="int"  LENGTH="10"  NOTNULL="true" SEQUENCE="true"/>
        <FIELD NAME="attemptid"    TYPE="int"  LENGTH="10"  NOTNULL="true"/>
        <FIELD NAME="userid"       TYPE="int"  LENGTH="10"  NOTNULL="true"/>
        <FIELD NAME="snapshot_url" TYPE="text" NOTNULL="false"/>
        <FIELD NAME="snapshot_type" TYPE="char" LENGTH="30" NOTNULL="true" DEFAULT="webcam" COMMENT="webcam|face|environment"/>
        <FIELD NAME="facefound"    TYPE="int"  LENGTH="1"   NOTNULL="true" DEFAULT="0"/>
        <FIELD NAME="awsscore"     TYPE="int"  LENGTH="10"  NOTNULL="true" DEFAULT="0"/>
        <FIELD NAME="timemodified" TYPE="int"  LENGTH="10"  NOTNULL="true"/>
      </FIELDS>
      <KEYS>
        <KEY NAME="primary"   TYPE="primary" FIELDS="id"/>
        <KEY NAME="attemptid" TYPE="foreign" FIELDS="attemptid" REFTABLE="learnguard_attempts" REFFIELDS="id"/>
      </KEYS>
      <INDEXES>
        <INDEX NAME="attemptid_type"  UNIQUE="false" FIELDS="attemptid, snapshot_type"/>
        <INDEX NAME="attemptid_time"  UNIQUE="false" FIELDS="attemptid, timemodified"/>
      </INDEXES>
    </TABLE>

    <!-- Event timeline (immutable audit trail) -->
    <TABLE NAME="learnguard_events" COMMENT="Immutable event audit trail per attempt">
      <FIELDS>
        <FIELD NAME="id"           TYPE="int"  LENGTH="10"  NOTNULL="true" SEQUENCE="true"/>
        <FIELD NAME="attemptid"    TYPE="int"  LENGTH="10"  NOTNULL="true"/>
        <FIELD NAME="userid"       TYPE="int"  LENGTH="10"  NOTNULL="true"/>
        <FIELD NAME="event_type"   TYPE="char" LENGTH="60"  NOTNULL="true"/>
        <FIELD NAME="event_data"   TYPE="text" NOTNULL="false"/>
        <FIELD NAME="severity"     TYPE="char" LENGTH="10"  NOTNULL="true" DEFAULT="info"/>
        <FIELD NAME="score_impact" TYPE="int"  LENGTH="10"  NOTNULL="true" DEFAULT="0"/>
        <FIELD NAME="timemodified" TYPE="int"  LENGTH="10"  NOTNULL="true"/>
      </FIELDS>
      <KEYS>
        <KEY NAME="primary"   TYPE="primary" FIELDS="id"/>
        <KEY NAME="attemptid" TYPE="foreign" FIELDS="attemptid" REFTABLE="learnguard_attempts" REFFIELDS="id"/>
      </KEYS>
      <INDEXES>
        <INDEX NAME="timemodified" UNIQUE="false" FIELDS="timemodified"/>
      </INDEXES>
    </TABLE>

    <!-- Question slots (which questions are in each activity) -->
    <TABLE NAME="learnguard_slots" COMMENT="Questions assigned to a LearnGuard activity">
      <FIELDS>
        <FIELD NAME="id"         TYPE="int" LENGTH="10" NOTNULL="true" SEQUENCE="true"/>
        <FIELD NAME="learnguard" TYPE="int" LENGTH="10" NOTNULL="true"/>
        <FIELD NAME="slot"       TYPE="int" LENGTH="10" NOTNULL="true" COMMENT="1-based slot number"/>
        <FIELD NAME="questionid" TYPE="int" LENGTH="10" NOTNULL="true"/>
        <FIELD NAME="page"       TYPE="int" LENGTH="10" NOTNULL="true" DEFAULT="1"/>
        <FIELD NAME="maxmark"    TYPE="number" LENGTH="10" NOTNULL="true" DEFAULT="1" DECIMALS="5"/>
      </FIELDS>
      <KEYS>
        <KEY NAME="primary"    TYPE="primary" FIELDS="id"/>
        <KEY NAME="learnguard" TYPE="foreign" FIELDS="learnguard" REFTABLE="learnguard" REFFIELDS="id"/>
        <KEY NAME="questionid" TYPE="foreign" FIELDS="questionid" REFTABLE="question" REFFIELDS="id"/>
      </KEYS>
    </TABLE>

    <!-- Per-student question order (supports randomization) -->
    <TABLE NAME="learnguard_attempt_questions" COMMENT="Per-attempt ordered question list, supporting randomization">
      <FIELDS>
        <FIELD NAME="id"          TYPE="int"  LENGTH="10" NOTNULL="true" SEQUENCE="true"/>
        <FIELD NAME="attemptid"   TYPE="int"  LENGTH="10" NOTNULL="true"/>
        <FIELD NAME="slotid"      TYPE="int"  LENGTH="10" NOTNULL="true" COMMENT="learnguard_slots.id"/>
        <FIELD NAME="questionid"  TYPE="int"  LENGTH="10" NOTNULL="true" COMMENT="learnguard_qbank.id"/>
        <FIELD NAME="slotnum"     TYPE="int"  LENGTH="10" NOTNULL="true" COMMENT="1-based position for this student"/>
        <FIELD NAME="timecreated" TYPE="int"  LENGTH="10" NOTNULL="true" DEFAULT="0"/>
      </FIELDS>
      <KEYS><KEY NAME="primary" TYPE="primary" FIELDS="id"/></KEYS>
      <INDEXES>
        <INDEX NAME="attemptid" UNIQUE="false" FIELDS="attemptid"/>
        <INDEX NAME="attemptslot" UNIQUE="true" FIELDS="attemptid,slotnum"/>
      </INDEXES>
    </TABLE>

    <!-- Own question bank: categories -->
    <TABLE NAME="learnguard_qbank_cats" COMMENT="LearnGuard question categories">
      <FIELDS>
        <FIELD NAME="id"          TYPE="int"  LENGTH="10"  NOTNULL="true" SEQUENCE="true"/>
        <FIELD NAME="name"        TYPE="char" LENGTH="255" NOTNULL="true"/>
        <FIELD NAME="description" TYPE="text" NOTNULL="false"/>
        <FIELD NAME="sortorder"   TYPE="int"  LENGTH="10"  NOTNULL="true" DEFAULT="0"/>
        <FIELD NAME="timecreated" TYPE="int"  LENGTH="10"  NOTNULL="true" DEFAULT="0"/>
        <FIELD NAME="timemodified" TYPE="int"  LENGTH="10"  NOTNULL="true" DEFAULT="0"/>
      </FIELDS>
      <KEYS><KEY NAME="primary" TYPE="primary" FIELDS="id"/></KEYS>
    </TABLE>

    <!-- Own question bank: questions -->
    <TABLE NAME="learnguard_qbank" COMMENT="LearnGuard own question bank">
      <FIELDS>
        <FIELD NAME="id"                  TYPE="int"    LENGTH="10"  NOTNULL="true" SEQUENCE="true"/>
        <FIELD NAME="categoryid"          TYPE="int"    LENGTH="10"  NOTNULL="true" DEFAULT="0"/>
        <FIELD NAME="name"                TYPE="char"   LENGTH="255" NOTNULL="true"/>
        <FIELD NAME="questiontext"        TYPE="text"   NOTNULL="false"/>
        <FIELD NAME="questiontextformat"  TYPE="int"    LENGTH="4"   NOTNULL="true" DEFAULT="1"/>
        <FIELD NAME="qtype"               TYPE="char"   LENGTH="20"  NOTNULL="true" DEFAULT="multichoice"
               COMMENT="multichoice|truefalse|shortanswer|essay"/>
        <FIELD NAME="defaultmark"         TYPE="number" LENGTH="10"  NOTNULL="true" DEFAULT="1" DECIMALS="5"/>
        <FIELD NAME="shuffleanswers"      TYPE="int"    LENGTH="1"   NOTNULL="true" DEFAULT="1"/>
        <FIELD NAME="generalfeedback"     TYPE="text"   NOTNULL="false"/>
        <FIELD NAME="generalfeedbackformat" TYPE="int" LENGTH="4"   NOTNULL="true" DEFAULT="1"/>
        <FIELD NAME="markingguidance"     TYPE="text"   NOTNULL="false" COMMENT="Essay-only: guidance text shown to graders"/>
        <FIELD NAME="markingguidanceformat" TYPE="int" LENGTH="4"  NOTNULL="true" DEFAULT="1"/>
        <FIELD NAME="timecreated"         TYPE="int"    LENGTH="10"  NOTNULL="true" DEFAULT="0"/>
        <FIELD NAME="timemodified"        TYPE="int"    LENGTH="10"  NOTNULL="true" DEFAULT="0"/>
        <FIELD NAME="createdby"           TYPE="int"    LENGTH="10"  NOTNULL="true" DEFAULT="0"/>
      </FIELDS>
      <KEYS><KEY NAME="primary" TYPE="primary" FIELDS="id"/></KEYS>
      <INDEXES><INDEX NAME="categoryid" UNIQUE="false" FIELDS="categoryid"/></INDEXES>
    </TABLE>

    <!-- Own question bank: answers / options -->
    <TABLE NAME="learnguard_qbank_answers" COMMENT="Answer options for LearnGuard questions">
      <FIELDS>
        <FIELD NAME="id"                TYPE="int"    LENGTH="10"  NOTNULL="true" SEQUENCE="true"/>
        <FIELD NAME="questionid"        TYPE="int"    LENGTH="10"  NOTNULL="true"/>
        <FIELD NAME="answertext"        TYPE="text"   NOTNULL="false"/>
        <FIELD NAME="answertextformat"  TYPE="int"    LENGTH="4"   NOTNULL="true" DEFAULT="1"/>
        <FIELD NAME="fraction"          TYPE="number" LENGTH="10"  NOTNULL="true" DEFAULT="0" DECIMALS="5"/>
        <FIELD NAME="feedback"          TYPE="text"   NOTNULL="false"/>
        <FIELD NAME="sortorder"         TYPE="int"    LENGTH="10"  NOTNULL="true" DEFAULT="0"/>
      </FIELDS>
      <KEYS><KEY NAME="primary" TYPE="primary" FIELDS="id"/></KEYS>
      <INDEXES><INDEX NAME="questionid" UNIQUE="false" FIELDS="questionid"/></INDEXES>
    </TABLE>

    <!-- Student responses (replaces Moodle quba for own questions) -->
    <TABLE NAME="learnguard_responses" COMMENT="Student responses to own-bank questions">
      <FIELDS>
        <FIELD NAME="id"           TYPE="int"    LENGTH="10"  NOTNULL="true" SEQUENCE="true"/>
        <FIELD NAME="attemptid"    TYPE="int"    LENGTH="10"  NOTNULL="true"/>
        <FIELD NAME="slotid"       TYPE="int"    LENGTH="10"  NOTNULL="true"/>
        <FIELD NAME="questionid"   TYPE="int"    LENGTH="10"  NOTNULL="true"/>
        <FIELD NAME="responsedata" TYPE="text"   NOTNULL="false" COMMENT="JSON encoded response"/>
        <FIELD NAME="fraction"     TYPE="number" LENGTH="10"  NOTNULL="true" DEFAULT="0" DECIMALS="5"/>
        <FIELD NAME="state"        TYPE="char"   LENGTH="20"  NOTNULL="true" DEFAULT="todo"
               COMMENT="todo|complete|needsgrading"/>
        <FIELD NAME="timecreated"  TYPE="int"    LENGTH="10"  NOTNULL="true" DEFAULT="0"/>
        <FIELD NAME="timemodified" TYPE="int"    LENGTH="10"  NOTNULL="true" DEFAULT="0"/>
      </FIELDS>
      <KEYS><KEY NAME="primary" TYPE="primary" FIELDS="id"/></KEYS>
      <INDEXES>
        <INDEX NAME="attemptid" UNIQUE="false" FIELDS="attemptid"/>
        <INDEX NAME="slotid"    UNIQUE="false" FIELDS="slotid"/>
      </INDEXES>
    </TABLE>

    <!-- Proctor assignments per activity -->
    <TABLE NAME="learnguard_proctors" COMMENT="Proctor assignments per activity">
      <FIELDS>
        <FIELD NAME="id"           TYPE="int"  LENGTH="10"  NOTNULL="true" SEQUENCE="true"/>
        <FIELD NAME="learnguard"   TYPE="int"  LENGTH="10"  NOTNULL="true"/>
        <FIELD NAME="userid"       TYPE="int"  LENGTH="10"  NOTNULL="true"/>
        <FIELD NAME="role"         TYPE="char" LENGTH="20"  NOTNULL="true" DEFAULT="proctor"/>
        <FIELD NAME="is_global"    TYPE="int"  LENGTH="1"   NOTNULL="true" DEFAULT="0"/>
        <FIELD NAME="courseid"     TYPE="int"  LENGTH="10"  NOTNULL="true" DEFAULT="0"/>
        <FIELD NAME="timemodified" TYPE="int"  LENGTH="10"  NOTNULL="true"/>
      </FIELDS>
      <KEYS><KEY NAME="primary" TYPE="primary" FIELDS="id"/></KEYS>
    </TABLE>

    <!-- Essay grader assignments -->
    <TABLE NAME="learnguard_graders" COMMENT="Essay grader assignments with anonymous and layer support">
      <FIELDS>
        <FIELD NAME="id"          TYPE="int" LENGTH="10" NOTNULL="true" SEQUENCE="true"/>
        <FIELD NAME="learnguard"  TYPE="int" LENGTH="10" NOTNULL="true"/>
        <FIELD NAME="userid"      TYPE="int" LENGTH="10" NOTNULL="true"/>
        <FIELD NAME="anonymous"   TYPE="int" LENGTH="1"  NOTNULL="true" DEFAULT="0"/>
        <FIELD NAME="gradelayer"  TYPE="int" LENGTH="1"  NOTNULL="true" DEFAULT="1"/>
        <FIELD NAME="timecreated" TYPE="int" LENGTH="10" NOTNULL="true" DEFAULT="0"/>
      </FIELDS>
      <KEYS><KEY NAME="primary" TYPE="primary" FIELDS="id"/></KEYS>
      <INDEXES><INDEX NAME="learnguard" UNIQUE="false" FIELDS="learnguard"/></INDEXES>
    </TABLE>

    <!-- Noise-triggered audio clips -->
    <TABLE NAME="learnguard_audio_clips" COMMENT="Audio clips recorded when noise threshold exceeded">
      <FIELDS>
        <FIELD NAME="id"          TYPE="int"  LENGTH="10" NOTNULL="true" SEQUENCE="true"/>
        <FIELD NAME="attemptid"   TYPE="int"  LENGTH="10" NOTNULL="true"/>
        <FIELD NAME="userid"      TYPE="int"  LENGTH="10" NOTNULL="true"/>
        <FIELD NAME="audiodata"   TYPE="text" NOTNULL="true"/>
        <FIELD NAME="duration"    TYPE="int"  LENGTH="10" NOTNULL="true" DEFAULT="0"/>
        <FIELD NAME="noise_level" TYPE="int"  LENGTH="10" NOTNULL="true" DEFAULT="0"/>
        <FIELD NAME="timecreated" TYPE="int"  LENGTH="10" NOTNULL="true" DEFAULT="0"/>
      </FIELDS>
      <KEYS><KEY NAME="primary" TYPE="primary" FIELDS="id"/></KEYS>
      <INDEXES><INDEX NAME="attemptid" UNIQUE="false" FIELDS="attemptid"/></INDEXES>
    </TABLE>

    <!-- Incident management -->
    <TABLE NAME="learnguard_incidents" COMMENT="Proctoring incidents flagged per attempt">
      <FIELDS>
        <FIELD NAME="id"           TYPE="int"  LENGTH="10" NOTNULL="true" SEQUENCE="true"/>
        <FIELD NAME="learnguard"   TYPE="int"  LENGTH="10" NOTNULL="true"/>
        <FIELD NAME="attemptid"    TYPE="int"  LENGTH="10" NOTNULL="true"/>
        <FIELD NAME="proctoriid"   TYPE="int"  LENGTH="10" NOTNULL="true"/>
        <FIELD NAME="severity"     TYPE="char" LENGTH="10"  NOTNULL="true" DEFAULT="medium"/>
        <FIELD NAME="title"        TYPE="char" LENGTH="255" NOTNULL="true"/>
        <FIELD NAME="description"  TYPE="text" NOTNULL="true"/>
        <FIELD NAME="status"       TYPE="char" LENGTH="20"  NOTNULL="true" DEFAULT="open"/>
        <FIELD NAME="resolution"   TYPE="text" NOTNULL="false"/>
        <FIELD NAME="timecreated"  TYPE="int"  LENGTH="10" NOTNULL="true" DEFAULT="0"/>
        <FIELD NAME="timeresolved" TYPE="int"  LENGTH="10" NOTNULL="true" DEFAULT="0"/>
      </FIELDS>
      <KEYS><KEY NAME="primary" TYPE="primary" FIELDS="id"/></KEYS>
      <INDEXES><INDEX NAME="attemptid" UNIQUE="false" FIELDS="attemptid"/></INDEXES>
    </TABLE>

    <!-- Essay grade overrides -->
    <TABLE NAME="learnguard_essay_grades" COMMENT="Manual essay grade overrides">
      <FIELDS>
        <FIELD NAME="id"          TYPE="int"    LENGTH="10" NOTNULL="true" SEQUENCE="true"/>
        <FIELD NAME="attemptid"   TYPE="int"    LENGTH="10" NOTNULL="true"/>
        <FIELD NAME="slotid"      TYPE="int"    LENGTH="10" NOTNULL="true"/>
        <FIELD NAME="graderid"    TYPE="int"    LENGTH="10" NOTNULL="true"/>
        <FIELD NAME="grade"       TYPE="number" LENGTH="10" NOTNULL="true" DEFAULT="0" DECIMALS="5"/>
        <FIELD NAME="feedback"    TYPE="text"   NOTNULL="false"/>
        <FIELD NAME="timegraded"  TYPE="int"    LENGTH="10" NOTNULL="true" DEFAULT="0"/>
      </FIELDS>
      <KEYS><KEY NAME="primary" TYPE="primary" FIELDS="id"/></KEYS>
    </TABLE>

    <!-- Proctor messages -->
    <TABLE NAME="learnguard_messages" COMMENT="Proctor-student in-exam chat messages">
      <FIELDS>
        <FIELD NAME="id"          TYPE="int"  LENGTH="10" NOTNULL="true" SEQUENCE="true"/>
        <FIELD NAME="attemptid"   TYPE="int"  LENGTH="10" NOTNULL="true"/>
        <FIELD NAME="userid"      TYPE="int"  LENGTH="10" NOTNULL="true"/>
        <FIELD NAME="sendertype"  TYPE="char" LENGTH="20" NOTNULL="true" DEFAULT="student"/>
        <FIELD NAME="message"     TYPE="text" NOTNULL="true"/>
        <FIELD NAME="timecreated" TYPE="int"  LENGTH="10" NOTNULL="true" DEFAULT="0"/>
      </FIELDS>
      <KEYS><KEY NAME="primary" TYPE="primary" FIELDS="id"/></KEYS>
      <INDEXES><INDEX NAME="attemptid" UNIQUE="false" FIELDS="attemptid"/></INDEXES>
    </TABLE>

    <!-- Face match approval requests (pre-exam, no attemptid needed) -->
    <TABLE NAME="learnguard_face_approvals" COMMENT="Pre-exam face match approval requests from students">
      <FIELDS>
        <FIELD NAME="id"           TYPE="int"  LENGTH="10" NOTNULL="true" SEQUENCE="true"/>
        <FIELD NAME="cmid"         TYPE="int"  LENGTH="10" NOTNULL="true"/>
        <FIELD NAME="userid"       TYPE="int"  LENGTH="10" NOTNULL="true"/>
        <FIELD NAME="status"       TYPE="char" LENGTH="20" NOTNULL="true" DEFAULT="pending"/>
        <FIELD NAME="passportdata" TYPE="text" NOTNULL="false"/>
        <FIELD NAME="matchpct"     TYPE="int"  LENGTH="3"  NOTNULL="true" DEFAULT="0"/>
        <FIELD NAME="reviewedby"   TYPE="int"  LENGTH="10" NOTNULL="false"/>
        <FIELD NAME="reviewnote"   TYPE="text" NOTNULL="false"/>
        <FIELD NAME="timecreated"  TYPE="int"  LENGTH="10" NOTNULL="true" DEFAULT="0"/>
        <FIELD NAME="timemodified" TYPE="int"  LENGTH="10" NOTNULL="true" DEFAULT="0"/>
      </FIELDS>
      <KEYS><KEY NAME="primary" TYPE="primary" FIELDS="id"/></KEYS>
      <INDEXES><INDEX NAME="cmid_userid" UNIQUE="false" FIELDS="cmid, userid"/></INDEXES>
    </TABLE>

    <!-- Precheck/approval chat messages -->
    <TABLE NAME="learnguard_fa_messages" COMMENT="Chat messages tied to face approval requests">
      <FIELDS>
        <FIELD NAME="id"          TYPE="int"  LENGTH="10" NOTNULL="true" SEQUENCE="true"/>
        <FIELD NAME="approvalid"  TYPE="int"  LENGTH="10" NOTNULL="true"/>
        <FIELD NAME="userid"      TYPE="int"  LENGTH="10" NOTNULL="true"/>
        <FIELD NAME="sendertype"  TYPE="char" LENGTH="20" NOTNULL="true" DEFAULT="student"/>
        <FIELD NAME="message"     TYPE="text" NOTNULL="true"/>
        <FIELD NAME="timecreated" TYPE="int"  LENGTH="10" NOTNULL="true" DEFAULT="0"/>
      </FIELDS>
      <KEYS><KEY NAME="primary" TYPE="primary" FIELDS="id"/></KEYS>
      <INDEXES><INDEX NAME="approvalid" UNIQUE="false" FIELDS="approvalid"/></INDEXES>
    </TABLE>

    <!-- Precheck session progress tracking -->
    <TABLE NAME="learnguard_precheck_sessions" COMMENT="Tracks students currently going through the precheck wizard">
      <FIELDS>
        <FIELD NAME="id"           TYPE="int"  LENGTH="10"  NOTNULL="true" SEQUENCE="true"/>
        <FIELD NAME="cmid"         TYPE="int"  LENGTH="10"  NOTNULL="true"/>
        <FIELD NAME="userid"       TYPE="int"  LENGTH="10"  NOTNULL="true"/>
        <FIELD NAME="current_step" TYPE="char" LENGTH="50"  NOTNULL="true" DEFAULT="welcome"/>
        <FIELD NAME="step_number"  TYPE="int"  LENGTH="3"   NOTNULL="true" DEFAULT="0"/>
        <FIELD NAME="total_steps"  TYPE="int"  LENGTH="3"   NOTNULL="true" DEFAULT="0"/>
        <FIELD NAME="timecreated"  TYPE="int"  LENGTH="10"  NOTNULL="true" DEFAULT="0"/>
        <FIELD NAME="timemodified" TYPE="int"  LENGTH="10"  NOTNULL="true" DEFAULT="0"/>
      </FIELDS>
      <KEYS><KEY NAME="primary" TYPE="primary" FIELDS="id"/></KEYS>
      <INDEXES><INDEX NAME="cmid_userid" UNIQUE="false" FIELDS="cmid, userid"/></INDEXES>
    </TABLE>

    <!-- Per-learner exam scheduling -->
    <TABLE NAME="learnguard_schedules" COMMENT="Per-learner date/time window assigned by the admin">
      <FIELDS>
        <FIELD NAME="id"           TYPE="int" LENGTH="10" NOTNULL="true" SEQUENCE="true"/>
        <FIELD NAME="learnguard"   TYPE="int" LENGTH="10" NOTNULL="true"/>
        <FIELD NAME="userid"       TYPE="int" LENGTH="10" NOTNULL="true"/>
        <FIELD NAME="timeopen"     TYPE="int" LENGTH="10" NOTNULL="true" DEFAULT="0"/>
        <FIELD NAME="timeclose"    TYPE="int" LENGTH="10" NOTNULL="true" DEFAULT="0"/>
        <FIELD NAME="createdby"    TYPE="int" LENGTH="10" NOTNULL="true" DEFAULT="0"/>
        <FIELD NAME="timecreated"  TYPE="int" LENGTH="10" NOTNULL="true" DEFAULT="0"/>
        <FIELD NAME="timemodified" TYPE="int" LENGTH="10" NOTNULL="true" DEFAULT="0"/>
      </FIELDS>
      <KEYS><KEY NAME="primary" TYPE="primary" FIELDS="id"/></KEYS>
      <INDEXES><INDEX NAME="learnguard_userid" UNIQUE="true" FIELDS="learnguard, userid"/></INDEXES>
    </TABLE>

    <!-- Per-activity branding override (falls back to global learnguard/brand_* settings when empty) -->
    <TABLE NAME="learnguard_brand_overrides" COMMENT="Per-activity branding overrides for the learner-facing assessment UI">
      <FIELDS>
        <FIELD NAME="id"              TYPE="int"  LENGTH="10"  NOTNULL="true" SEQUENCE="true"/>
        <FIELD NAME="learnguard"      TYPE="int"  LENGTH="10"  NOTNULL="true"/>
        <FIELD NAME="brand_name"      TYPE="char" LENGTH="255" NOTNULL="false"/>
        <FIELD NAME="brand_primary"   TYPE="char" LENGTH="20"  NOTNULL="false"/>
        <FIELD NAME="brand_accent"    TYPE="char" LENGTH="20"  NOTNULL="false"/>
        <FIELD NAME="brand_textcolor" TYPE="char" LENGTH="20"  NOTNULL="false"/>
        <FIELD NAME="timemodified"    TYPE="int"  LENGTH="10"  NOTNULL="true" DEFAULT="0"/>
      </FIELDS>
      <KEYS><KEY NAME="primary" TYPE="primary" FIELDS="id"/></KEYS>
      <INDEXES><INDEX NAME="learnguard" UNIQUE="true" FIELDS="learnguard"/></INDEXES>
    </TABLE>

    <!-- Per-activity essay grading distribution mode -->
    <TABLE NAME="learnguard_grading_config" COMMENT="Per-activity essay grading distribution settings">
      <FIELDS>
        <FIELD NAME="id"           TYPE="int"  LENGTH="10" NOTNULL="true" SEQUENCE="true"/>
        <FIELD NAME="learnguard"   TYPE="int"  LENGTH="10" NOTNULL="true"/>
        <FIELD NAME="gradingmode"  TYPE="char" LENGTH="20" NOTNULL="true" DEFAULT="all"/>
        <FIELD NAME="gradingcap"   TYPE="int"  LENGTH="10" NOTNULL="true" DEFAULT="0"/>
        <FIELD NAME="timemodified" TYPE="int"  LENGTH="10" NOTNULL="true" DEFAULT="0"/>
      </FIELDS>
      <KEYS><KEY NAME="primary" TYPE="primary" FIELDS="id"/></KEYS>
      <INDEXES><INDEX NAME="learnguard" UNIQUE="true" FIELDS="learnguard"/></INDEXES>
    </TABLE>

    <!-- Distributes finished attempts to specific Layer-1 graders for split/random/manual grading modes -->
    <TABLE NAME="learnguard_grader_assignments" COMMENT="Maps finished attempts to the Layer-1 grader responsible for them">
      <FIELDS>
        <FIELD NAME="id"          TYPE="int" LENGTH="10" NOTNULL="true" SEQUENCE="true"/>
        <FIELD NAME="learnguard"  TYPE="int" LENGTH="10" NOTNULL="true"/>
        <FIELD NAME="attemptid"   TYPE="int" LENGTH="10" NOTNULL="true"/>
        <FIELD NAME="graderid"    TYPE="int" LENGTH="10" NOTNULL="true"/>
        <FIELD NAME="timecreated" TYPE="int" LENGTH="10" NOTNULL="true" DEFAULT="0"/>
      </FIELDS>
      <KEYS><KEY NAME="primary" TYPE="primary" FIELDS="id"/></KEYS>
      <INDEXES><INDEX NAME="learnguard_attempt" UNIQUE="true" FIELDS="learnguard, attemptid"/></INDEXES>
    </TABLE>

  </TABLES>
</XMLDB>
